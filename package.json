{
  "name": "todo-app",
  "version": "1.0.0",
  "description": "Gerenciador de Tarefas — Express + Vanilla JS + Cypress",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "node backend/server.js",
    "test": "cypress run --headless",
